# TransCode Lab Environment Variables

# Node Express Backend
PORT=4000
NODE_ENV=development
DATABASE_PATH=./database/transcode.sqlite
MODEL_SERVICE_URL=http://localhost:8000
EXECUTION_RUNNER_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173

# Python Model Service
MODEL_SERVICE_PORT=8000
MODEL_CACHE_DIR=./.cache/models
DEFAULT_DEVICE=cpu
MAX_CONCURRENT_INFERENCES=2

# Execution Runner / Sandbox
EXECUTION_RUNNER_PORT=5000
SANDBOX_MODE=restricted_local
RUNNER_TIMEOUT_SECONDS=5
MAX_OUTPUT_BYTES=65536
DOCKER_IMAGE_PYTHON=transcode-runner-python:3.11
DOCKER_IMAGE_JAVA=transcode-runner-java:17

# Frontend
VITE_API_URL=http://localhost:4000/api/v1

